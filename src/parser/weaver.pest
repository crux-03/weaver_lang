// 
// weaver-lang grammar
// 
// Two layers: template (top-level, free-form text with embedded constructs)
// and expression (typed values inside constructs).
// 
// Template parsing is NOT whitespace-insensitive. Raw text matters.
// Expression parsing (inside constructs) IS whitespace-insensitive, with one
// exception: a binary operator must begin on the same line as its left
// operand. See `expr`.

// ── Top-level ───────────────────────────────────────────────────────────

template        = { SOI ~ node* ~ EOI }
expr_standalone = { SOI ~ ws ~ expr ~ ws ~ EOI }

node = _{
    if_block
  | foreach_block
  | control_stmt
  | expression_node
  | command_node
  | literal_text
}

/// Raw text — everything that isn't a weaver construct.
/// Matches one or more characters that don't start a construct.
literal_text = @{
    (!("{{" | "{#" | "@[" | "$[" | "<trigger" | "[[") ~ ANY)+
}

// ── Expression nodes (template-level, result gets string-coerced) ───────

expression_node = _{
    interpolation
  | processor_call
  | trigger
  | document_ref
}

// ── Command node (template-level, return value is optional) ─────────────

command_node = { command_call }

// ── Interpolation: {{ expr }} ───────────────────────────────────────────
//
// `{{ ... }}` holds any expression, not just a variable. The common case
// is still a bare reference (`{{npc.name}}`, `{{global:hp}}`); arithmetic
// (`{{ 1 + 2 }}`) and literals (`{{ {name: "Alice"} }}`) are the same rule.

interpolation = { "{{" ~ trim_l? ~ ws ~ expr ~ ws ~ trim_r? ~ "}}" }

// ── References: scope:name or a bare name, either with a dotted path ────
//
// A reference is an ordinary expression atom, so it is legal anywhere an
// expression is: `{{global:hp}}`, `{# if global:hp > 5 #}`,
// `$[set_var("local:n", n + 1)]`.
//
// The FIRST segment is the variable name — the part the host resolves, or
// the loop binding. Every segment after it indexes into the resolved value.
// A bare reference resolves against loop bindings only; the host's scopes
// are reachable only through `scope:name`.

reference  = { scoped_ref | bare_ref }
scoped_ref = { identifier ~ ":" ~ dotted_name }
bare_ref   = { dotted_name }

// ── Processors: @[namespace.name(key: value, key2: value2)] ─────────────

processor_call = {
    "@[" ~ trim_l? ~ ws ~ dotted_name ~ "(" ~ ws ~ property_list? ~ ws ~ ")" ~ ws ~ trim_r? ~ "]"
}

property_list = { property ~ (sep ~ property)* ~ sep? }

property = { identifier ~ ws ~ ":" ~ ws ~ expr }

// ── Commands: $[name(arg1, arg2)] ───────────────────────────────────────

command_call = {
    "$[" ~ trim_l? ~ ws ~ identifier ~ "(" ~ ws ~ arg_list? ~ ws ~ ")" ~ ws ~ trim_r? ~ "]"
}

arg_list = { expr ~ (sep ~ expr)* ~ sep? }

// ── Triggers: <trigger id="entry-id"> or <trigger id={{var}}> ───────────

trigger = {
    "<trigger" ~ ws ~ "id" ~ ws ~ "=" ~ ws ~ trigger_id ~ ws ~ ">"
}

/// The id is either a string literal or an expression that evaluates to
/// one. Bare binary expressions are NOT allowed here because `>` would be
/// ambiguous with the closing delimiter — parenthesize instead:
/// <trigger id=({{scope:base}} + "_suffix")>
trigger_id = _{
    quoted_string
  | interpolation
  | processor_call
  | command_call
  | "(" ~ ws ~ expr ~ ws ~ ")"
}

// ── Documents: [[DOCUMENT_ID]] or [[{{var}}]] ───────────────────────────

document_ref = {
    "[[" ~ ws ~ document_id ~ ws ~ "]]"
}

/// `document_ref` is tried before `array_literal` inside `atom`, so
/// `[[LOOT]]` is the document `LOOT` in every position rather than an array
/// holding the array holding a reference. A genuinely nested single-element
/// array needs a space: `[ [x] ]`. Anything with a second element —
/// `[[a, b], [c]]` — is unambiguous and parses as an array either way.
///
/// The trailing `identifier` is a literal id, not a reference: `[[LOOT]]`
/// names the document `LOOT` rather than reading a variable called `LOOT`.
document_id = _{
    interpolation
  | processor_call
  | command_call
  | "(" ~ ws ~ expr ~ ws ~ ")"
  | identifier
}

// ── Flow statements: {# break #}, {# continue #}, {# return expr #} ─────
//
// These share the control-flow delimiter because that is what they are.
// `kw_end` prevents a longer identifier from starting a match it cannot
// finish: without it `{# breakpoint #}` begins matching `break_stmt`,
// fails at `#}`, and reports an error pointing at the wrong thing.

control_stmt = _{ break_stmt | continue_stmt | return_stmt | stop_stmt }

break_stmt    = { "{#" ~ trim_l? ~ ws ~ "break" ~ kw_end ~ ws ~ trim_r? ~ "#}" }
continue_stmt = { "{#" ~ trim_l? ~ ws ~ "continue" ~ kw_end ~ ws ~ trim_r? ~ "#}" }

/// `{# return expr #}` makes `expr` the template's value, discarding the
/// output rendered before it. A bare `{# return #}` is sugar for
/// `{# return none #}`.
return_stmt = { "{#" ~ trim_l? ~ ws ~ "return" ~ kw_end ~ (ws ~ expr)? ~ ws ~ trim_r? ~ "#}" }

/// `{# stop #}` ends evaluation and keeps the output rendered so far.
stop_stmt = { "{#" ~ trim_l? ~ ws ~ "stop" ~ kw_end ~ ws ~ trim_r? ~ "#}" }

kw_end = _{ !(ASCII_ALPHANUMERIC | "_") }

// ── Control flow ────────────────────────────────────────────────────────
//
// Every keyword carries `kw_end` for the same reason the flow statements
// do: now that a bare identifier is a valid expression, `{# iffy #}` would
// otherwise start matching `if_open` and consume `fy` as its condition.

if_block = {
    if_open ~ node* ~ elif_branch* ~ else_branch? ~ if_close
}

if_open  = { "{#" ~ trim_l? ~ ws ~ "if" ~ kw_end ~ ws ~ expr ~ ws ~ trim_r? ~ "#}" }
if_close = { "{#" ~ trim_l? ~ ws ~ "endif" ~ kw_end ~ ws ~ trim_r? ~ "#}" }

elif_branch = {
    "{#" ~ trim_l? ~ ws ~ "elif" ~ kw_end ~ ws ~ expr ~ ws ~ trim_r? ~ "#}" ~ node*
}

else_branch = {
    "{#" ~ trim_l? ~ ws ~ "else" ~ kw_end ~ ws ~ trim_r? ~ "#}" ~ node*
}

foreach_block = {
    foreach_open ~ node* ~ foreach_close
}

foreach_open  = { "{#" ~ trim_l? ~ ws ~ "foreach" ~ kw_end ~ ws ~ identifier ~ ws ~ "in" ~ kw_end ~ ws ~ expr ~ ws ~ trim_r? ~ "#}" }
foreach_close = { "{#" ~ trim_l? ~ ws ~ "endforeach" ~ kw_end ~ ws ~ trim_r? ~ "#}" }

// ── Expressions ─────────────────────────────────────────────────────────
// Used inside if conditions, processor values, command args, foreach
// iterables, and `{{ }}`.
//
// Whitespace-insensitive with one exception: `ws_inline` before `bin_op`
// means a binary operator must start on the same line as its left operand.
// An expression still continues freely across lines *after* an operator:
//
//     @[p(x: 1 +          ok — the operator ends the line
//            2)]
//     @[p(x: 1
//            + 2)]        not one expression
//
// That rule is what makes a newline usable as a separator (see `sep`). Were
// `1` and `-2` on consecutive lines allowed to join, `[1\n-2]` would be the
// single element `-1` rather than the two elements written.

expr = { unary_expr ~ (ws_inline ~ bin_op ~ ws ~ unary_expr)* }

unary_expr = {
    unary_op ~ ws ~ postfix_expr
  | postfix_expr
}

// ── Indexing ────────────────────────────────────────────────────────────
//
// `items[0]`, `obj["key"]`, `items[i].name`. A suffix must be glued to the
// value it indexes — no whitespace before `[` or `.` — so that a newline
// separator can never be mistaken for an index: in `[a\n[1]]` the second
// line is an element, not a subscript of the first.

postfix_expr = { atom ~ postfix_op* }
postfix_op   = _{ index_suffix | field_suffix }
index_suffix = { "[" ~ ws ~ expr ~ ws ~ "]" }
field_suffix = { "." ~ identifier }

atom = {
    "(" ~ ws ~ expr ~ ws ~ ")"
  | document_ref
  | array_literal
  | interpolation
  | object_literal
  | processor_call
  | command_call
  | trigger
  | bool_literal
  | none_literal
  | number
  | quoted_string
  | reference
}

array_literal = { "[" ~ ws ~ (expr ~ (sep ~ expr)* ~ sep?)? ~ ws ~ "]" }

// ── Object literals: {name: "Alice", hp: 10} ────────────────────────────
//
// Keys are identifiers or quoted strings, so existing JSON parses as
// written. `{` is unambiguous here: `{{` is an interpolation and `{#` a
// control tag, both tried first, and neither can begin an object.

object_literal = { "{" ~ ws ~ (object_entry ~ (sep ~ object_entry)* ~ sep?)? ~ ws ~ "}" }
object_entry   = { object_key ~ ws ~ ":" ~ ws ~ expr }
object_key     = _{ identifier | quoted_string }

// ── Separators ──────────────────────────────────────────────────────────
//
// Comma or newline, and a trailing one is allowed. A loop that emits one
// element per line needs neither to insert commas between generated items
// nor to suppress the last one.

sep = _{ ws_inline ~ (("," ~ ws) | (NEWLINE ~ ws ~ ("," ~ ws)?)) }

// ── Operators ───────────────────────────────────────────────────────────

bin_op = {
    "=="
  | "!="
  | "<="
  | ">="
  | "<"
  | ">"
  | "&&"
  | "||"
  | "+"
  | "-"
  | "*"
  | "/"
  | "%"
}

unary_op = { "!" | "-" }

// ── Literals & atoms ────────────────────────────────────────────────────
//
// `kw_end` keeps the keywords from being prefixes of references: without
// it `truename` would match `true` and leave `name` dangling.

bool_literal = @{ ("true" | "false") ~ kw_end }
none_literal = @{ "none" ~ kw_end }

number = @{
    "-"? ~ ASCII_DIGIT+ ~ ("." ~ ASCII_DIGIT+)?
}

/// Double-quoted string with escape sequences
quoted_string = ${ "\"" ~ string_inner ~ "\"" }
string_inner  = @{ (escape_seq | !("\"" | "\\") ~ ANY)* }
escape_seq    = @{ "\\" ~ ("\"" | "\\" | "n" | "t" | "r") }

// ── Identifiers ─────────────────────────────────────────────────────────

identifier = @{
    (ASCII_ALPHA | "_") ~ (ASCII_ALPHANUMERIC | "_")*
}

/// Dotted name for namespaced processors: "core.weaver.rng"
dotted_name = @{
    identifier ~ ("." ~ identifier)*
}

// ── Trim markers ────────────────────────────────────────────────────────
//
// A `-` immediately inside a delimiter eats the whitespace on that side:
// `{#- if x -#}`, `{{- name -}}`, `$[- cmd() -]`. Left and right are
// separate rules so a lone marker can be told apart from its position in
// the pair tree.
//
// A left marker may not be followed by a digit, so `{{-1}}` is negative
// one rather than a trim of `1`. Otherwise the rule is positional: `-`
// glued to the opening delimiter trims, `-` after a space negates —
// `{{-x}}` trims and renders `x`, `{{ -x }}` renders its negation.
//
// On the right there is no ambiguity to resolve. In `{# if x -#}` pest's
// `expr` tries to consume `- <atom>`, fails at `#}`, and backtracks the
// repetition — so `{# if x - 1 -#}` parses as `x - 1` with a trailing
// marker, as written.

trim_l = { "-" ~ !ASCII_DIGIT }
trim_r = { "-" }

// ── Whitespace (explicit, not implicit) ─────────────────────────────────
// We do NOT use pest's implicit WHITESPACE rule because template-level
// text is whitespace-significant. Instead we use `ws` explicitly inside
// expression contexts. `ws_inline` is the same thing without line breaks,
// for the places where a newline carries meaning.

ws        = _{ (" " | "\t" | "\r" | "\n")* }
ws_inline = _{ (" " | "\t")* }
